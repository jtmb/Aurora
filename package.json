{
  "name": "aurora-gateway",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up -d && turbo dev",
    "dev:stop": "docker compose down",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:migrate": "turbo db:migrate",
    "db:generate": "turbo db:generate",
    "db:studio": "docker run --rm -e PGHOST=localhost -e PGPORT=5432 -e PGUSER=postgres -e PGPASSWORD=postgres -d postgres",
    "backup": "./scripts/backup.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "ioredis": "^5.11.0"
  }
}
