# .env.example — Environment variables for Aurora code-server
# Copy to .env and customize for your setup

# ── LM Studio Connection ────────────────────────────────────────────
# Set to your LM Studio instance URL (check the "Developer" tab in LM Studio)
LMSTUDIO_URL=http://localhost:1234/v1
# Any model loaded in LM Studio — get the exact ID from http://YOUR_HOST:1234/v1/models
LMSTUDIO_MODEL=qwen-coder
# LM Studio doesn't require auth, but the sk- prefix satisfies Cline's format check
LMSTUDIO_API_KEY=sk-lm-studio

# ── Cline CLI Settings ──────────────────────────────────────────────
CLINE_PROVIDER=openai-compatible
CLINE_TIMEOUT=600

# ── Orchestrator Settings ───────────────────────────────────────────
TASK=
MAX_ITERATIONS=50
COOLDOWN_MS=2000
ORCHESTRATOR_PLAN_FIRST=true   # Always run plan phase before execution (recommended)

# ── Ports ───────────────────────────────────────────────────────────
CODE_SERVER_PORT=8080
